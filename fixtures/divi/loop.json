                                                                "decoration": {
                                                                    "spacing": {
                                                                        "desktop": {
                                                                            "value": {
                                                                                "margin": {
                                                                                    "top": "20px",
                                                                                    "right": "20px",
                                                                                    "bottom": "20px",
                                                                                    "left": "20px",
                                                                                    "syncVertical": "off",
                                                                                    "syncHorizontal": "off"
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            },
                                                            "content": {
                                                                "innerContent": {
                                                                    "desktop": {
                                                                        "value": "<p>$variable({\"type\":\"content\",\"value\":{\"name\":\"post_excerpt\",\"settings\":{\"words\":\"20\"}}})$ — $variable({\"type\":\"content\",\"value\":{\"name\":\"post_date\",\"settings\":{\"date_format\":\"custom\",\"custom_date_format\":\"F j, Y\"}}})$ by $variable({\"type\":\"content\",\"value\":{\"name\":\"post_author\",\"settings\":{\"name_format\":\"display_name\"}}})$</p>"
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        "elements": []
                                                    }
                                                ]
                                            }
