                                                                            {
                                                                                "value": "post"
                                                                            }
                                                                        ],
                                                                        "postPerPage": "6",
                                                                        "orderBy": "date",
                                                                        "order": "DESC",
                                                                        "excludeCurrentPost": "on"
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "css": {
                                                        "desktop": {
                                                            "value": {
                                                                "freeForm": "selector { flex: 0 0 calc((100% - 24px * 2) / 3); max-width: calc((100% - 24px * 2) / 3); min-width: 0; }"
                                                            }
                                                        }
                                                    }
                                                },
                                                "elements": [
                                                    {
                                                        "id": "h1",
                                                        "name": "divi/heading",
