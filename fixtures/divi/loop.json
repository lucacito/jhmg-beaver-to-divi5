                                                                "decoration": {
                                                                    "spacing": {
                                                                        "desktop": {
                                                                            "value": {
                                                                                "margin": {
                                                                                    "top": "20px",
                                                                                    "right": "20px",
                                                                                    "bottom": "20px",
                                                                                    "left": "20px",
                                                                                    "syncVertical": "off",
                                                                                    "syncHorizontal": "off"
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                },
                                                                "advanced": {
                                                                    "link": {
                                                                        "desktop": {
                                                                            "value": {
