                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            },
                                                            "title": {
                                                                "innerContent": {
                                                                    "desktop": {
                                                                        "value": "$variable({\"type\":\"content\",\"value\":{\"name\":\"post_title\",\"settings\":{}}})$"
                                                                    }
                                                                },
                                                                "decoration": {
                                                                    "font": {
                                                                        "font": {
                                                                            "desktop": {
                                                                                "value": {
                                                                                    "headingLevel": "h3"
